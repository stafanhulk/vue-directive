{
  "name": "vue-directive",
  "version": "0.0.1",
  "description": "Vue 3 自定义指令集合",
  "type": "module",
  "main": "./dist/vue-directive.umd.cjs",
  "module": "./dist/vue-directive.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-directive.js",
      "require": "./dist/vue-directive.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^25.3.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vue": "^3.4.0",
    "vue-tsc": "^1.8.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "directive",
    "directives"
  ],
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
